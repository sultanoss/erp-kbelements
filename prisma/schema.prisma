generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(USER)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activities     ActivityLog[]
  corrections    Correction[]
  herdsetSales   HerdsetSale[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  sales          Sale[]
}

model Item {
  sku                  String                 @id
  stock                Int                    @default(0)
  minStock             Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  stockNS              Int                    @default(0)
  name                 String                 @default("")
  purchasePrice        Float?
  description          String?
  highlights           String?
  imageUrl             String?
  scopeOfDelivery      String?
  activities           ActivityLog[]
  corrections          Correction[]
  image                ItemImage?
  priceColumnValues    PriceColumnValue[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchasePriceHistory PurchasePriceHistory[]
  receipts             Receipt[]
  sales                Sale[]
  shipmentItems        ShipmentItem[]
  skuMappingItems      SkuMappingItem[]
}

model ItemImage {
  sku         String @id
  data        Bytes
  contentType String @default("image/jpeg")
  item        Item   @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model Sale {
  id          String      @id @default(cuid())
  date        DateTime
  marketplace Marketplace
  sku         String
  quantity    Int
  userId      String
  createdAt   DateTime    @default(now())
  source      String      @default("TAGESVERKAUF")
  item        Item        @relation(fields: [sku], references: [sku])
  user        User        @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([sku])
}

model Receipt {
  id        String   @id @default(cuid())
  date      DateTime
  sku       String
  quantity  Int
  userId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [sku], references: [sku])
  user      User     @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([sku])
}

model Correction {
  id                  String        @id @default(cuid())
  date                DateTime
  sku                 String
  quantity            Int
  reason              String
  userId              String
  createdAt           DateTime      @default(now())
  lager               String        @default("neuware")
  austausch           Boolean       @default(false)
  austauschAngekommen Boolean       @default(false)
  activityLogs        ActivityLog[]
  item                Item          @relation(fields: [sku], references: [sku])
  user                User          @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([sku])
}

model HerdsetSale {
  id          String      @id @default(cuid())
  date        DateTime
  marketplace Marketplace
  label       String
  quantity    Int
  userId      String
  createdAt   DateTime    @default(now())
  orderId     String?
  user        User        @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([orderId])
}

model Invoice {
  id                 String        @id @default(cuid())
  number             String        @unique
  date               DateTime
  customerName       String
  customerAddress    String
  customerNum        String?
  mwstRate           Int           @default(19)
  notes              String?
  paymentInfo        String?
  createdAt          DateTime      @default(now())
  userId             String
  shippingCost       Float?
  paymentMethod      String        @default("konto")
  status             String        @default("aktiv")
  storniertAt        DateTime?
  shippingMwst       Int           @default(19)
  docType            String        @default("rechnung")
  originalInvoiceId  String?
  originalInvoiceNum String?
  marketplace        String?
  orderId            String?
  bezahlt            Boolean       @default(true)
  bezahltAt          DateTime?
  customerPhone      String?
  user               User          @relation(fields: [userId], references: [id])
  items              InvoiceItem[]

  @@index([date])
  @@index([number])
  @@index([status])
  @@index([docType])
  @@index([orderId])
}

model InvoiceItem {
  id          String           @id @default(cuid())
  invoiceId   String
  pos         Int
  quantity    Float
  description String
  unitPrice   Float
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  skus        InvoiceItemSku[]
}

model InvoiceItemSku {
  id            String      @id @default(cuid())
  invoiceItemId String
  sku           String
  lager         String      @default("neuware")
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
}

model Order {
  id             String      @id @default(cuid())
  externalId     String      @unique
  marketplace    String
  status         String      @default("NEU")
  customerName   String
  street         String
  zip            String
  city           String
  country        String      @default("DE")
  orderDate      DateTime
  trackingNumber String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderNumber    String?
  billingName    String?
  billingStreet  String?
  billingZip     String?
  billingCity    String?
  billingCountry String?
  phoneNumber    String?
  herdsetLabel   String?
  isHerdset      Boolean     @default(false)
  note           String?
  items          OrderItem[]
  shipments      Shipment[]

  @@index([status])
  @@index([marketplace])
  @@index([orderDate])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  marketplaceSku String
  internalSku    String?
  title          String
  quantity       Int
  price          Float
  positionItemId String?
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                   String         @id @default(cuid())
  orderId              String
  carrier              String
  status               String         @default("LABEL_CREATED")
  trackingNumber       String?
  labelUrl             String?
  dhlShipmentId        String?
  weight               Float?
  carrierResponse      Json?
  notifiedOttoAt       DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  returnTrackingNumber String?
  returnLabelUrl       String?
  salesCreated         Boolean        @default(false)
  labelPrinted         Boolean        @default(false)
  positionItemIds      String[]       @default([])
  order                Order          @relation(fields: [orderId], references: [id])
  items                ShipmentItem[]

  @@index([orderId])
  @@index([status])
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  internalSku String
  quantity    Int
  warehouse   String   @default("neuware")
  createdAt   DateTime @default(now())
  item        Item     @relation(fields: [internalSku], references: [sku])
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  date          DateTime
  supplier      String
  invoiceNumber String
  notes         String?
  userId        String
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id])
  items         PurchaseOrderItem[]

  @@index([date])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  sku              String
  quantity         Int
  purchasePrice    Float
  oldPurchasePrice Float?
  oldStock         Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item             Item          @relation(fields: [sku], references: [sku])
}

model PurchasePriceHistory {
  id              String   @id @default(cuid())
  sku             String
  date            DateTime
  supplier        String
  invoiceNumber   String
  quantity        Int
  purchasePrice   Float
  purchaseOrderId String
  createdAt       DateTime @default(now())
  item            Item     @relation(fields: [sku], references: [sku])

  @@index([sku])
  @@index([purchaseOrderId])
}

model PriceColumn {
  id        String             @id @default(cuid())
  title     String
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  values    PriceColumnValue[]
}

model PriceColumnValue {
  id            String      @id @default(cuid())
  priceColumnId String
  sku           String
  price         Float?
  updatedAt     DateTime    @updatedAt
  priceColumn   PriceColumn @relation(fields: [priceColumnId], references: [id], onDelete: Cascade)
  item          Item        @relation(fields: [sku], references: [sku])

  @@unique([priceColumnId, sku])
  @@index([sku])
}

model SkuMapping {
  id             String           @id @default(cuid())
  marketplace    String
  marketplaceSku String
  label          String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  items          SkuMappingItem[]

  @@unique([marketplace, marketplaceSku])
}

model SkuMappingItem {
  id          String     @id @default(cuid())
  mappingId   String
  internalSku String
  item        Item       @relation(fields: [internalSku], references: [sku])
  mapping     SkuMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
}

model B2cCustomer {
  id          String   @id @default(cuid())
  name        String
  address     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customerNum String?
  phone       String?

  @@index([name])
}

model B2bCustomer {
  id            String   @id @default(cuid())
  name          String
  customerNum   String?
  address       String
  paymentMethod String   @default("konto")
  paymentInfo   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  mwstRate      Int      @default(19)
  phone         String?

  @@index([name])
}

model Setting {
  key   String @id
  value String
}

model LaterShipment {
  id           String   @id @default(cuid())
  orderNumber  String
  note         String?
  shippingDate DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id           String       @id @default(cuid())
  type         ActivityType
  sku          String?
  oldStock     Int?
  newStock     Int?
  note         String?
  userId       String
  createdAt    DateTime     @default(now())
  correctionId String?
  correction   Correction?  @relation(fields: [correctionId], references: [id])
  item         Item?        @relation(fields: [sku], references: [sku])
  user         User         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([type])
  @@index([sku])
}

enum Role {
  ADMIN
  USER
}

enum Marketplace {
  OTTO
  AMAZON
  KAUFLAND
  MEDIAMARKT
  EBAY
  SHOPIFY
  DIREKT
  EBAY_OUTLET
}

enum ActivityType {
  SALE
  RECEIPT
  CORRECTION
  USER_CHANGE
  SHIPMENT
  STORNO
  INVOICE
}
